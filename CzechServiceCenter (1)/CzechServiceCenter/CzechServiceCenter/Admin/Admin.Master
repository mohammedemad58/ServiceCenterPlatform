<%@ Master Language="C#" MasterPageFile="~/Site.Master" %>
<asp:Content ContentPlaceHolderID="MainContent" runat="server">
  <section class="page-head admin-head"><div class="container"><h1>Administration</h1>
    <nav class="subnav">
      <a href="<%= ResolveUrl("~/Admin/Default.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Default.aspx" ? " class=\"on\"" : "" %>>Dashboard</a>
      <a href="<%= ResolveUrl("~/Admin/Bookings.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Bookings.aspx" ? " class=\"on\"" : "" %>>Bookings</a>
      <a href="<%= ResolveUrl("~/Admin/Parts.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Parts.aspx" ? " class=\"on\"" : "" %>>Parts &amp; Inventory</a>
      <a href="<%= ResolveUrl("~/Admin/Orders.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Orders.aspx" ? " class=\"on\"" : "" %>>Orders</a>
      <a href="<%= ResolveUrl("~/Admin/Fitment.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Fitment.aspx" ? " class=\"on\"" : "" %>>Fitment</a>
      <a href="<%= ResolveUrl("~/Admin/Records.aspx") %>"<%= Request.AppRelativeCurrentExecutionFilePath == "~/Admin/Records.aspx" ? " class=\"on\"" : "" %>>Maintenance Records</a>
    </nav></div></section>
  <section class="section"><div class="container">
    <asp:ContentPlaceHolder ID="AdminContent" runat="server" />
  </div></section>
</asp:Content>
