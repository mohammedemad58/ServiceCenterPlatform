<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CzechServiceCenter.SiteMaster" %>
<%@ Import Namespace="CzechServiceCenter" %>
<!DOCTYPE html>
<html lang="<%= Lang.Code %>" dir="<%= Lang.Dir %>">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Czech Service Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body data-root="<%= ResolveUrl("~/") %>" class="lang-<%= Lang.Code %>">
<!-- SVG sprite: logo + icons -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <clipPath id="csc-shield"><path d="M36 33h48v28c0 15-11 25-24 30-13-5-24-15-24-30z"/></clipPath>
    <symbol id="csc-logo" viewBox="0 0 120 120">
      <circle cx="60" cy="60" r="57" fill="#0b1f45" stroke="#fff" stroke-width="3"/>
      <circle cx="60" cy="60" r="49" fill="none" stroke="#fff" stroke-opacity=".45" stroke-dasharray="2 5"/>
      <g clip-path="url(#csc-shield)">
        <rect x="36" y="33" width="24" height="60" fill="#e30613"/>
        <rect x="60" y="33" width="24" height="60" fill="#1c4fa3"/>
        <rect x="36" y="56" width="48" height="12" fill="#fff"/>
      </g>
      <path d="M36 33h48v28c0 15-11 25-24 30-13-5-24-15-24-30z" fill="none" stroke="#fff" stroke-width="2.5"/>
      <text x="60" y="108" text-anchor="middle" font-family="Inter,Arial" font-weight="800" font-size="11" fill="#fff">CSC</text>
    </symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
    <symbol id="i-wrench" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
    <symbol id="i-car" viewBox="0 0 24 24"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></symbol>
    <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/><circle cx="12" cy="12" r="7.5"/></symbol>
    <symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5L17 22l-5-3-5 3 1.5-8.5"/></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></symbol>
    <symbol id="i-phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></symbol>
    <symbol id="i-fb" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></symbol>
    <symbol id="i-ig" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></symbol>
    <symbol id="i-yt" viewBox="0 0 24 24"><path d="M22.5 6.4a2.8 2.8 0 0 0-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.4a2.8 2.8 0 0 0-2 2C1 8.1 1 12 1 12s0 3.9.5 5.6a2.8 2.8 0 0 0 2 2C5.2 20 12 20 12 20s6.8 0 8.5-.4a2.8 2.8 0 0 0 2-2C23 15.9 23 12 23 12s0-3.9-.5-5.6z"/><path d="M9.8 15V9l5.2 3z"/></symbol>
    <symbol id="i-in" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></symbol>
    <symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
  </defs>
</svg>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-lockup" href="<%= ResolveUrl("~/") %>" aria-label="Czech Service Center home">
      <svg class="logo" viewBox="0 0 120 120"><use href="#csc-logo"/></svg>
      <span class="brand-text"><strong>CZECH SERVICE CENTER</strong><small>SERVICE &nbsp;&bull;&nbsp; GENUINE PARTS &nbsp;&bull;&nbsp; TRUST</small></span>
    </a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="main-nav" id="mainNav" aria-label="Main">
      <a class="nav-link<%= Active("Default.aspx") %>" href="<%= ResolveUrl("~/") %>">Home</a>
      <a class="nav-link" href="<%= ResolveUrl("~/Default.aspx") %>#about">About Us</a>
      <div class="has-menu">
        <a class="nav-link<%= Active("Brand.aspx") %>" href="<%= ResolveUrl("~/Default.aspx") %>#brands">Our Brands <svg class="ico" viewBox="0 0 24 24"><use href="#i-chev"/></svg></a>
        <div class="menu">
          <a href="<%= ResolveUrl("~/Brand.aspx?b=audi") %>">Audi</a>
          <a href="<%= ResolveUrl("~/Brand.aspx?b=skoda") %>">&Scaron;koda</a>
          <a href="<%= ResolveUrl("~/Brand.aspx?b=seat") %>">SEAT</a>
          <a href="<%= ResolveUrl("~/Brand.aspx?b=volkswagen") %>">Volkswagen</a>
          <a href="<%= ResolveUrl("~/Brand.aspx?b=cupra") %>">CUPRA</a>
        </div>
      </div>
      <a class="nav-link<%= Active("Parts.aspx") %>" href="<%= ResolveUrl("~/Parts.aspx") %>">Genuine Parts</a>
      <a class="nav-link<%= Active("Services.aspx") %>" href="<%= ResolveUrl("~/Services.aspx") %>">Service Schedule</a>
      <a class="nav-link<%= Active("Book.aspx") %>" href="<%= ResolveUrl("~/Book.aspx") %>">Book Service</a>
      <a class="nav-link<%= Active("Contact.aspx") %>" href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a>
      <span class="nav-sep"></span>
      <a class="nav-link lang-btn" href="<%: LangUrl %>" lang="<%= Lang.IsAr ? "en" : "ar" %>" hreflang="<%= Lang.IsAr ? "en" : "ar" %>"><%= Lang.IsAr ? "English" : "&#1575;&#1604;&#1593;&#1585;&#1576;&#1610;&#1577;" %></a>
      <a class="nav-link cart-link<%= Active("Cart.aspx") %>" href="<%= ResolveUrl("~/Cart.aspx") %>">Cart<% if (CartCount > 0) { %> <span class="cart-count"><%= CartCount %></span><% } %></a>
      <% if (IsLoggedIn) { %>
        <% if (IsAdmin) { %><a class="nav-link" href="<%= ResolveUrl("~/Admin/Default.aspx") %>">Admin</a><% } %>
        <a class="nav-link" href="<%= ResolveUrl("~/Account/Profile.aspx") %>">My Account</a>
        <a class="nav-link" href="<%= ResolveUrl("~/Logout.aspx") %>">Log out</a>
      <% } else { %>
        <a class="nav-link" href="<%= ResolveUrl("~/Login.aspx") %>">Log in</a>
      <% } %>
    </nav>
  </div>
</header>

<main>
  <asp:ContentPlaceHolder ID="MainContent" runat="server" />
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <a class="brand-lockup" href="<%= ResolveUrl("~/") %>">
      <svg class="logo" viewBox="0 0 120 120"><use href="#csc-logo"/></svg>
      <span class="brand-text"><strong>CZECH SERVICE CENTER</strong><small>SERVICE &nbsp;&bull;&nbsp; GENUINE PARTS &nbsp;&bull;&nbsp; TRUST</small></span>
    </a>
    <div class="foot-col">
      <h4>Follow Us</h4>
      <div class="social">
        <a href="#" aria-label="Facebook"><svg class="ico" viewBox="0 0 24 24"><use href="#i-fb"/></svg></a>
        <a href="#" aria-label="Instagram"><svg class="ico" viewBox="0 0 24 24"><use href="#i-ig"/></svg></a>
        <a href="#" aria-label="YouTube"><svg class="ico" viewBox="0 0 24 24"><use href="#i-yt"/></svg></a>
        <a href="#" aria-label="LinkedIn"><svg class="ico" viewBox="0 0 24 24"><use href="#i-in"/></svg></a>
      </div>
    </div>
    <div class="foot-col">
      <h4>Contact Us</h4>
      <p><svg class="ico" viewBox="0 0 24 24"><use href="#i-phone"/></svg> <%: Phone %></p>
      <p><svg class="ico" viewBox="0 0 24 24"><use href="#i-pin"/></svg> <%: Address %></p>
      <p><a href="<%= ResolveUrl("~/Order.aspx") %>">Track your order</a></p>
    </div>
  </div>
  <div class="copyright"><%: Lang.T("© {0} Czech Service Center. All rights reserved.", DateTime.Now.Year) %></div>
</footer>
<script>window.CSC_I18N = { selectTime: "<%= HttpUtility.JavaScriptStringEncode(Lang.T("Select Time")) %>", closed: "<%= HttpUtility.JavaScriptStringEncode(Lang.IsAr ? "\u0627\u0644\u0645\u0631\u0643\u0632 \u0645\u063a\u0644\u0642 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645" : "Closed on this day") %>", full: "<%= HttpUtility.JavaScriptStringEncode(Lang.IsAr ? "\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0648\u0627\u0639\u064a\u062f \u0645\u062a\u0627\u062d\u0629" : "Fully booked") %>", selectBranchFirst: "<%= HttpUtility.JavaScriptStringEncode(Lang.IsAr ? "\u0627\u062e\u062a\u0631 \u0627\u0644\u0641\u0631\u0639 \u0623\u0648\u0644\u064b\u0627" : "Select a branch first") %>" };</script>
<script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
<asp:ContentPlaceHolder ID="Scripts" runat="server" />
</body>
</html>
