<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!-- عدّل اسم السيرفر حسب جهازك -->
		<add name="CSC" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=CzechServiceCenter;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
  <appSettings>
    <add key="Bays" value="3" />                 <!-- cars that can be serviced at the same time slot -->
    <add key="SlotStartHour" value="9" />        <!-- first slot 09:00 -->
    <add key="SlotEndHour" value="17" />         <!-- last slot starts 16:00 -->
    <add key="ClosedDay" value="Friday" />
    <add key="LowStockThreshold" value="5" />
    <add key="AdminEmail" value="admin@czechservice.local" />
    <add key="AdminPassword" value="Admin@12345" />   <!-- change after first login / before going live -->
    <add key="CenterPhone" value="+20 2 1234 5678" />
    <add key="CenterAddress" value="Our Service Center" />
    <!-- Online shop -->
    <add key="PaymentMode" value="Test" />            <!-- Test = simulated card page (no money). Paymob = real card payments -->
    <add key="SiteUrl" value="" />                    <!-- public address, e.g. https://www.yourdomain.com (needed behind a proxy) -->
    <add key="DeliveryFee" value="0" />               <!-- EGP added to orders with delivery -->
    <add key="CardHoldMinutes" value="30" />          <!-- unpaid card orders release their stock after this -->
    <add key="InstaPayHoldHours" value="24" />        <!-- InstaPay orders without a reference release their stock after this -->
    <add key="InstaPayHandle" value="" />             <!-- the center's InstaPay address (IPA), shown to customers -->
    <add key="InstaPayAccountName" value="" />
    <add key="InstaPayPhone" value="" />
    <!-- Paymob Accept (only used when PaymentMode = Paymob). Keep real values out of source control. -->
    <add key="PaymobApiKey" value="" />
    <add key="PaymobIntegrationId" value="" />        <!-- card integration id from the Paymob dashboard -->
    <add key="PaymobIframeId" value="" />
    <add key="PaymobHmac" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" enableVersionHeader="false" />
    <authentication mode="Forms">
      <forms name=".CSCAUTH" loginUrl="~/Login.aspx" defaultUrl="~/Account/Profile.aspx" timeout="60" slidingExpiration="true" protection="All" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <sessionState mode="InProc" timeout="120" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <globalization culture="en-US" uiCulture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <!-- customers only -->
  <location path="Account">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <!-- administrators only -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers></system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
